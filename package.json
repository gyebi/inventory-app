{
  "name": "calkris-darf-ventures",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "typecheck": "tsc --project jsconfig.check.json --noEmit --pretty false",
    "typecheck:baseline": "python3 quality/check-typecheck-baseline.py",
    "lint": "eslint js functions/index.js printer-bridge",
    "lint:baseline": "node quality/check-eslint-baseline.mjs",
    "test": "node --test printer-bridge/test/*.test.js quality/test/*.test.mjs && python3 -B -m unittest discover -s quality/test -p 'test_*.py'",
    "verify": "npm run typecheck:baseline && npm run lint:baseline && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "firebase": "^12.12.1"
  }
}
