rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(currentUserPath());
    }

    function currentUserRole() {
      return get(currentUserPath()).data.role;
    }

    function isAdmin() {
      return hasUserProfile() && currentUserRole() == "admin";
    }

    function canReadUser(userId) {
      return hasUserProfile() && (
        currentUserRole() == "admin" ||
        request.auth.uid == userId
      );
    }

    function canManageStock() {
      return hasUserProfile() && (
        currentUserRole() == "admin" ||
        currentUserRole() == "manager" ||
        currentUserRole() == "storekeeper"
      );
    }

    function canManageSettings() {
      return hasUserProfile() && (
        currentUserRole() == "admin" ||
        currentUserRole() == "manager"
      );
    }

    function canCreateSale() {
      return hasUserProfile() && (
        currentUserRole() == "admin" ||
        currentUserRole() == "sales"
      );
    }

    function secureSalesEnabled() {
      return exists(/databases/$(database)/documents/settings/secureSales) &&
        get(/databases/$(database)/documents/settings/secureSales).data.enabled == true;
    }

    function doesNotChangeAuthoritativeStock() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "quantity",
        "sellableQuantity",
        "inventorySchemaVersion"
      ]);
    }

    function canUpdateSecureProduct() {
      return canManageStock() && doesNotChangeAuthoritativeStock() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "pricingStatus",
          "sellingPricePesewas",
          "bulkSellingPricePesewas",
          "pricingApprovedAt",
          "pricingApprovedBy"
        ]) || canManageSettings()
      );
    }

    function canUpdateProductStockForSale() {
      return canCreateSale() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "quantity",
            "stock",
            "updatedAt",
            "updatedBy"
          ]);
    }

    match /users/{userId} {
      allow read: if canReadUser(userId);
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, delete: if !secureSalesEnabled() && canManageStock();
      allow update: if (!secureSalesEnabled() && (canManageStock()
        || canUpdateProductStockForSale()))
        || (secureSalesEnabled() && canUpdateSecureProduct());
    }

    match /stockReceipts/{receiptId} {
      allow read: if signedIn();
      allow create, update, delete: if !secureSalesEnabled() && canManageStock();
    }

    match /suppliers/{supplierId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageStock();
    }

    match /supplierPayments/{paymentId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageStock();
    }

    match /sales/{saleId} {
      allow read: if signedIn();
      allow create: if !secureSalesEnabled() && canCreateSale();
      allow update, delete: if !secureSalesEnabled() && isAdmin();
    }

    // Immutable server-controlled legacy loss and stocktake correction ledger.
    match /stockAdjustments/{adjustmentId} {
      allow read: if hasUserProfile();
      allow write: if false;
    }

    // Server-only persisted drafts and final reports.
    match /openingStockProducts/{productId} {
      allow read: if hasUserProfile();
      allow write: if false;
    }

    match /stocktakeSessions/{sessionId} {
      allow read: if hasUserProfile();
      allow write: if false;
    }

    match /adjustmentRequests/{requestId} {
      allow read, write: if false;
    }

    match /stocktakeStartRequests/{requestId} {
      allow read, write: if false;
    }

    // The Admin SDK in the callable Function is the only writer once secure mode is enabled.
    match /stockBatches/{batchId} {
      allow read: if hasUserProfile();
      allow write: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if hasUserProfile();
      allow write: if false;
    }

    match /saleRequests/{requestId} {
      allow read: if hasUserProfile();
      allow write: if false;
    }

    // Secure receiving writes these only through receiveSecureStock.
    match /receiveRequests/{requestId} {
      allow read, write: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if hasUserProfile();
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      // Weekly stocktaking cadence is validated by the admin-only callable.
      allow create, update, delete: if settingId != "weeklyStocktaking" && canManageSettings();
    }

    match /priceChanges/{priceChangeId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageSettings();
    }
  }
}
