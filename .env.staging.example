# Copy to .env.staging only after a separate Firebase project has been created.
# Do not use inventory-app-19d04 values in this file.
VITE_FIREBASE_API_KEY=staging_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-staging-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-staging-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=staging_messaging_sender_id
VITE_FIREBASE_APP_ID=staging_web_app_id
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
